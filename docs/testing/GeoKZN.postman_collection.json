      "name": "00 Public",
      "item": [
        {
          "name": "GET report reasons",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/report-reasons"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Reasons list returned', function () { pm.expect(data.items).to.be.an('array').that.is.not.empty; });",
                  "const picked = data.items.find(x => x.name === 'other') || data.items[0];",
                  "pm.collectionVariables.set('reportReasonId', String(picked.reason_id));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET event types",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/event-types"
          },
          "event": [
