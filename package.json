{
  "name": "testapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node ./scripts/expo.js start",
    "start:tunnel": "node ./scripts/expo.js start --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node ./scripts/expo.js start --android",
    "ios": "node ./scripts/expo.js start --ios",
